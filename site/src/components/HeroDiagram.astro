---
// The idea in one picture: your tuner, Yagi, and the media servers of the people you share it with. Dropped on the
// page like stickers, a little crooked each, joined by loose dashed lines. Positions are percentages of a 700 x 320
// box, so it scales down to a phone as it is.
import hdhomerun from '../assets/icons/hdhomerun.svg';
import plex from '../assets/icons/plex.svg';
import jellyfin from '../assets/icons/jellyfin.svg';
import emby from '../assets/icons/emby.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const W = 700;
const H = 320;
// x, y: the center in the 700 x 320 box; size: width as a percent of the box; turn: degrees.
const nodes = [
  { name: 'Your HDHomeRun', src: hdhomerun.src, x: 85, y: 170, size: 14, turn: -8 },
  { name: 'Yagi', src: `${base}/brand/yagi-logo.svg`, x: 330, y: 150, size: 19, turn: 4, yagi: true },
  { name: 'Plex', src: plex.src, x: 590, y: 55, size: 11, turn: 9 },
  { name: 'Jellyfin', src: jellyfin.src, x: 628, y: 165, size: 11, turn: -6 },
  { name: 'Emby', src: emby.src, x: 560, y: 275, size: 11, turn: 7 },
];
const paths = [
  'M135 178 C190 120, 235 215, 262 160',
  'M398 140 C455 110, 480 55, 537 62',
  'M398 160 C470 175, 540 150, 575 163',
  'M390 190 C440 215, 470 285, 510 272',
];
---

<figure class="diagram" aria-label="Your HDHomeRun tuner, shared through Yagi with the Plex, Jellyfin and Emby servers of family and friends">
  <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
    {paths.map((d) => <path d={d} />)}
  </svg>
  {
    nodes.map((n) => (
      <div
        class:list={['node', { yagi: n.yagi }]}
        style={`left:${(n.x / W) * 100}%;top:${(n.y / H) * 100}%;width:${n.size}%;--turn:${n.turn}deg`}
      >
        <img src={n.src} alt="" />
        <span>{n.name}</span>
      </div>
    ))
  }
</figure>

<style>
  .diagram {
    position: relative;
    aspect-ratio: 700 / 320;
    max-width: 36rem;
    margin: 0 auto;
    container-type: inline-size;
  }
  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  path {
    fill: none;
    stroke: color-mix(in oklab, var(--sl-color-accent) 75%, transparent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 2 9;
    vector-effect: non-scaling-stroke;
    animation: flow 1.2s linear infinite;
  }
  .node {
    position: absolute;
    transform: translate(-50%, -50%) rotate(var(--turn));
    transition: transform 0.25s ease;
    text-align: center;
  }
  .node:hover {
    transform: translate(-50%, -50%) rotate(0deg) scale(1.06);
  }
  .node img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 18%;
    box-shadow: 0 10px 15px 0 rgb(0 0 0 / 0.3);
  }
  .node.yagi img {
    outline: 3px solid var(--sl-color-accent);
    outline-offset: 0;
  }
  .node span {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) rotate(calc(var(--turn) * -1));
    margin-top: 0.6rem;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    font-size: clamp(0.65rem, 2.4cqw, 0.875rem);
  }
  .node.yagi span {
    color: var(--sl-color-white);
    font-weight: 700;
    font-family: 'Mozilla Headline Variable', var(--sl-font);
    font-size: clamp(0.8rem, 3cqw, 1.1rem);
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -22;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    path {
      animation: none;
    }
    .node {
      transition: none;
    }
  }
</style>
